# Copy to .env and adjust. Every value here has a working default for local development.

ENVIRONMENT=development

# SQLite works out of the box; use PostgreSQL in production (docker-compose sets this for you).
DATABASE_URL=sqlite:///./newslearn.db
# DATABASE_URL=postgresql+psycopg://newslearn:newslearn@localhost:5432/newslearn

# REQUIRED in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-before-deploying
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=60
# The first account registered becomes the admin. Set to false afterwards to close sign-up.
REGISTRATION_OPEN=true

# AI. "mock" needs no key and produces placeholder text (for development and tests).
# For real summaries choose a provider and give its key:
#   AI_PROVIDER=gemini  with GEMINI_API_KEY     (default model gemini-3.8-flash)
#   AI_PROVIDER=claude  with ANTHROPIC_API_KEY  (default model claude-opus-5-5)
# AI_MODEL overrides the provider's default model. AI_EFFORT applies to Claude only.
AI_PROVIDER=mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=
AI_EFFORT=low
# Hard stop for AI spend per day (Asia/Dhaka day). Processing resumes the next day.
AI_DAILY_BUDGET_USD=1.00
AI_MAX_ARTICLES_PER_RUN=15
# Pacing for article processing. Gemini's free tier allows 5 requests a minute.
AI_REQUESTS_PER_MINUTE=4

# News collection
SCHEDULER_ENABLED=true
COLLECT_INTERVAL_MINUTES=30
PROCESS_INTERVAL_MINUTES=10
ARTICLE_MAX_AGE_HOURS=72
ARTICLE_RETENTION_DAYS=90
HTTP_USER_AGENT=NewsLearnBD/0.1 (personal study app)

# Per-user limits for on-demand AI features (requests per day)
EXPLAIN_DAILY_LIMIT=60
TUTOR_DAILY_LIMIT=40

# Comma separated origins allowed by CORS (the Android app does not need this)
CORS_ORIGINS=
